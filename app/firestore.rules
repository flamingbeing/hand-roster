// Built by app-devkit tools/build-rules.mjs from firestore.app.rules and rules/common.rules. Edit those, then rebuild.
rules_version = '2';
// The app's rules. Edit this file, then build: node .devkit/tools/build-rules.mjs app/firestore.app.rules
// (writes firestore.rules, which is what deploys and the emulator use; CI fails when it is stale).
// Roles come from custom claims (app-devkit rules kit): { g: { _: role }, x, v, m }; '_' is the single group.
service cloud.firestore {
  match /databases/{database}/documents {
    // app-devkit rules/common.rules 1.5.0. Shared helpers, pasted in by tools/build-rules.mjs; do not edit the copy.
    // Claims (a cache of the app's role docs, never the source of truth; all optional):
    //   g  { <groupId>: <role> }  the user's role per group; a single-group app uses the key '_'
    //   x  unix seconds           access ends then (absent = no end)
    //   v  int                    claims version, bumped when the role docs change
    //   m  string                 sign-in method; written for the record, never read by rules
    // No email in authorisation. Lookups: only notRevoked() reads a document (1); the rest reads the token.

    function isSignedIn() { return request.auth != null; }

    // The user's role in group gid, or '' (no claim, other group, signed out).
    function role(gid) { return isSignedIn() ? request.auth.token.get('g', {}).get(gid, '') : ''; }

    function inGroup(gid) { return role(gid) != ''; }

    function hasRole(gid, roles) { return inGroup(gid) && role(gid) in roles; }

    // Not past the claim's access end. A malformed x fails closed.
    function live() {
      return isSignedIn() && (!('x' in request.auth.token) || request.time < timestamp.value(request.auth.token.x * 1000));
    }

    // One lookup: revoked/{uid} is written by the app's server when a member is removed, deleted when claims are re-issued.
    // Keep revoked/ closed to clients (no match block for it).
    function notRevoked() { return isSignedIn() && !exists(/databases/$(database)/documents/revoked/$(request.auth.uid)); }

    // The usual gate: role in the list, access not ended, not revoked (the lookup runs only when the role fits).
    function can(gid, roles) { return hasRole(gid, roles) && live() && notRevoked(); }

    // Migration form while old clients have no claims: the claim when present, else the role from the app's own doc.
    // Arguments are evaluated first, so a get() passed as docRole is read even when the claim decides. To skip that read,
    // write the same form inline: role(gid) != '' ? role(gid) : get(...).data.role (see the multi-group example).
    function roleOrDoc(gid, docRole) { return role(gid) != '' ? role(gid) : docRole; }

    // Server stamps (writes): stamped() requires serverAt == request.time; stampOk() also accepts no serverAt (old clients).
    function stamped() { return request.resource.data.get('serverAt', null) == request.time; }
    function stampOk() { return !('serverAt' in request.resource.data) || request.resource.data.serverAt == request.time; }

    // Partial updates from older clients that send no serverAt: it must stay exactly what the stored document has (absent
    // stays absent). Use instead of stampOk() on update only while such clients exist. Trade-off: the edit keeps its old
    // serverAt, so readers that fetch only what changed after a serverAt (server mode, incremental) do not see that edit
    // until their next full read (a weekly one, for apps that run one). Drop it once every client stamps.
    function stampKept() { return request.resource.data.get('serverAt', null) == resource.data.get('serverAt', null); }

    // The field is a timestamp that is not after the server's time (a future-dated version would sort first for good).
    // A client clock ahead of the server is refused too; write request.time with serverTimestamp where that matters.
    function notFuture(field) {
      return request.resource.data.get(field, null) is timestamp && request.resource.data.get(field, null) <= request.time;
    }

    // The field holds the signed-in user's uid (an author stamp nobody can write for someone else).
    function authorIs(field) { return isSignedIn() && request.resource.data.get(field, null) == request.auth.uid; }

    // The role docs: each person reads their own (the page watches its v), admins read all. Only the Worker writes them
    // (/api/members/, worker/members.js): a removal there also revokes the account, which a page's delete could not.
    match /members/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || can('_', ['admin']);
      allow write: if false;
    }

    // Checks every roster record shares. d is the incoming record: a text is required, or optional (absent or null); a day is
    // YYYY-MM-DD. createdAt is a number set once and never changed; _edits says who changed each field (app-sync).
    function str(d, f, max) { return f in d && d[f] is string && d[f].size() > 0 && d[f].size() <= max; }
    function optStr(d, f, max) { return !(f in d) || d[f] == null || (d[f] is string && d[f].size() <= max); }
    function oneOfStr(d, f, allowed) { return f in d && d[f] is string && d[f] in allowed; }
    function optOneOf(d, f, allowed) { return !(f in d) || d[f] == null || (d[f] is string && d[f] in allowed); }
    function intIn(d, f, lo, hi) { return f in d && d[f] is int && d[f] >= lo && d[f] <= hi; }
    function optIntIn(d, f, lo, hi) { return !(f in d) || d[f] == null || (d[f] is int && d[f] >= lo && d[f] <= hi); }
    function optBool(d, f) { return !(f in d) || d[f] is bool; }
    function isDay(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function dayIn(d, f) { return f in d && isDay(d[f]); }
    function optList(d, f, max) { return !(f in d) || (d[f] is list && d[f].size() <= max); }
    // A maker's draft of a week or a month (src/roster/drafts.js): absent, null (dropped) or a map of the plan's own fields,
    // checked as the record's; viewers read it with the record but the app shows them the record's own fields.
    function draftOk(d, keys) { return !('draft' in d) || d.draft == null || (d.draft is map && d.draft.keys().hasOnly(keys)); }
    function weekPlanOk(d) {
      return optList(d, 'grid', 800) && optList(d, 'accepted', 300) && optList(d, 'lists', 400) && optList(d, 'overrides', 200)
        && optIntIn(d, 'seed', 0, 1000000) && (!('built' in d) || d.built is number);
    }
    function monthPlanOk(d) {
      return optList(d, 'calls', 62) && optList(d, 'accepted', 300) && optList(d, 'locked', 200) && optList(d, 'problems', 60)
        && optIntIn(d, 'seed', 0, 1000000) && (!('built' in d) || d.built is number);
    }
    function recordOk(d) {
      return (!('_edits' in d) || d._edits is map)
        && d.updatedAt is number
        && (!('createdAt' in d) || d.createdAt is number)
        && (resource == null || !('createdAt' in resource.data) || !('createdAt' in d) || d.createdAt == resource.data.createdAt);
    }

    // The doctors the roster places. A name is the key leave, requests and calls use. grade: con (consultant), reg (registrar or
    // fellow), mo (medical officer); team is free text ("Team 1"); active false takes someone off without losing the old rosters.
    // phone is optional, digits, spaces and + only (owner, 7 Nov 2026: a call link beside on-call names, every viewer reads it).
    match /spaces/{g}/people/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'grade', 'rank', 'site', 'team', 'phone', 'active', 'noCall', 'moCalls', 'siteOnly', 'byHand', 'works', 'clinicsOnly', 'extra', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'name', 60)
        && oneOfStr(request.resource.data, 'grade', ['con', 'reg', 'mo'])
        && optStr(request.resource.data, 'rank', 20)
        && optOneOf(request.resource.data, 'site', ['NUH', 'NTFGH'])
        && optStr(request.resource.data, 'team', 30)
        && (!('phone' in request.resource.data) || request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.matches('^[+0-9 ]{1,20}$')))
        && optBool(request.resource.data, 'active') && optBool(request.resource.data, 'noCall') && optBool(request.resource.data, 'moCalls') && optBool(request.resource.data, 'siteOnly') && optBool(request.resource.data, 'byHand') && optBool(request.resource.data, 'clinicsOnly')
        && (!('works' in request.resource.data) || request.resource.data.works == null || (request.resource.data.works is list && request.resource.data.works.size() <= 10 && request.resource.data.works.hasOnly(['1AM', '1PM', '2AM', '2PM', '3AM', '3PM', '4AM', '4PM', '5AM', '5PM'])))
        && optBool(request.resource.data, 'extra')
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // The weekly template of OT lists and clinics: one row per list per session of a weekday (wd 1 Monday to 5 Friday).
    match /spaces/{g}/lists/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['site', 'kind', 'name', 'wd', 'session', 'consultant', 'consultant2', 'consultant3', 'rooms', 'patients', 'need', 'min', 'status', 'external', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'site', 20)
        && oneOfStr(request.resource.data, 'kind', ['ot', 'msp', 'clinic', 'hot'])
        && str(request.resource.data, 'name', 40)
        && intIn(request.resource.data, 'wd', 1, 5)
        && oneOfStr(request.resource.data, 'session', ['AM', 'PM'])
        && optStr(request.resource.data, 'consultant', 60) && optStr(request.resource.data, 'consultant2', 60) && optStr(request.resource.data, 'consultant3', 60) && optStr(request.resource.data, 'rooms', 40)
        && optIntIn(request.resource.data, 'patients', 0, 200)
        && intIn(request.resource.data, 'need', 0, 10) && optIntIn(request.resource.data, 'min', 0, 10)
        && oneOfStr(request.resource.data, 'status', ['open', 'closed', 'template', 'empty', 'consultant-only'])
        && optBool(request.resource.data, 'external')
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // Leave: a person away from a day to a day (inclusive), all day or one session.
    match /spaces/{g}/leave/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'from', 'to', 'session', 'note', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'name', 60)
        && dayIn(request.resource.data, 'from') && dayIn(request.resource.data, 'to') && request.resource.data.from <= request.resource.data.to
        && optOneOf(request.resource.data, 'session', ['AM', 'PM', 'both'])
        && optStr(request.resource.data, 'note', 200)
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // Call requests: a day a person cannot do or would like, for one tier or any.
    match /spaces/{g}/requests/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'date', 'type', 'tier', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'name', 60)
        && dayIn(request.resource.data, 'date')
        && oneOfStr(request.resource.data, 'type', ['cannot', 'want'])
        && optOneOf(request.resource.data, 'tier', ['con', 'reg', 'reg2', 'moNuh', 'moNtf'])
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // A month's on-call roster, named YYYY-MM: calls (a row per day), locked (entries set by hand), holidays, problems,
    // tierPlan (which call tiers each kind of day has), accepted (warnings a maker accepted) and draft (a maker's working copy).
    match /spaces/{g}/rosters/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped() && id.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['calls', 'locked', 'holidays', 'problems', 'tierPlan', 'minGap', 'seed', 'built', 'accepted', 'draft', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && monthPlanOk(request.resource.data) && optList(request.resource.data, 'holidays', 31) && optIntIn(request.resource.data, 'minGap', 0, 7)
        && draftOk(request.resource.data, ['calls', 'locked', 'problems', 'seed', 'built', 'accepted'])
        && (request.resource.data.get('draft', null) == null || monthPlanOk(request.resource.data.draft))
        && (!('tierPlan' in request.resource.data) || (request.resource.data.tierPlan is map && request.resource.data.tierPlan.keys().hasOnly(['weekday', 'sat', 'sun', 'ph'])))
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // A week's daily roster, named by its Monday (YYYY-MM-DD): the grid, a snapshot of the lists as built, this week's changes,
    // accepted (warnings a maker accepted) and draft (a maker's working copy).
    match /spaces/{g}/weeks/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped() && isDay(id)
        && request.resource.data.keys().hasOnly(['grid', 'lists', 'overrides', 'built', 'seed', 'accepted', 'draft', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && weekPlanOk(request.resource.data)
        && draftOk(request.resource.data, ['grid', 'lists', 'overrides', 'built', 'seed', 'accepted'])
        && (request.resource.data.get('draft', null) == null || weekPlanOk(request.resource.data.draft))
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // The roster's rule cards (src/roster/rule-cards.js), app-roster's rule shape: a maker's copy of a default card (the
    // same id) or their own. Makers (admins, members) write them, viewers read them.
    match /spaces/{g}/rules/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped() && id.matches('^[A-Za-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['type', 'words', 'level', 'priority', 'tags', 'on', 'params', 'topic', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'type', 20) && optStr(request.resource.data, 'words', 200)
        && oneOfStr(request.resource.data, 'level', ['block', 'warn', 'soft']) && intIn(request.resource.data, 'priority', 1, 3)
        && optList(request.resource.data, 'tags', 20) && optBool(request.resource.data, 'on')
        && (!('params' in request.resource.data) || request.resource.data.params is map)
        && optOneOf(request.resource.data, 'topic', ['week', 'calls'])
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // modules: rules{ written from app/rules/*.rules by node tools/modules.mjs; edit those, not this block
    // }modules

    // Each person's account options (@core/settings): one doc named by their uid, writable by them alone. The group can read the
    // docs because a list listen cannot be proven to ask for only one (rules are not filters); keep secrets out of options.
    // One field per account option (src/options.js: none yet, every option is this device's); null forgets a saved value.
    match /spaces/{g}/settings/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member', 'viewer']) && request.auth.uid == id && stamped()
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt', 'serverAt', '_edits'])
        && (!('_edits' in request.resource.data) || request.resource.data._edits is map)
        && (!('profile' in request.resource.data) || request.resource.data.profile == null || request.resource.data.profile is string)
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // A deleted item's last version, written in the delete's own transaction (cloud.js onCommit).
    match /spaces/{g}/bin/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['id', 'kind', 'data', 'deletedAt', 'updatedAt', 'serverAt']);
    }
  }
}
