rules_version = '2';
// The app's rules. Edit this file, then build: node .devkit/tools/build-rules.mjs app/firestore.app.rules
// (writes firestore.rules, which is what deploys and the emulator use; CI fails when it is stale).
// Roles come from custom claims (app-devkit rules kit): { g: { _: role }, x, v, m }; '_' is the single group.
service cloud.firestore {
  match /databases/{database}/documents {
    // devkit:common

    // The role docs: each person reads their own (the page watches its v), admins read all. Only the Worker writes them
    // (/api/members/, worker/members.js): a removal there also revokes the account, which a page's delete could not.
    match /members/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || can('_', ['admin']);
      allow write: if false;
    }

    // Checks every roster record shares. d is the incoming record: a text is required, or optional (absent or null); a day is
    // YYYY-MM-DD. createdAt is a number set once and never changed; _edits says who changed each field (app-sync).
    function str(d, f, max) { return f in d && d[f] is string && d[f].size() > 0 && d[f].size() <= max; }
    function optStr(d, f, max) { return !(f in d) || d[f] == null || (d[f] is string && d[f].size() <= max); }
    function oneOfStr(d, f, allowed) { return f in d && d[f] is string && d[f] in allowed; }
    function optOneOf(d, f, allowed) { return !(f in d) || d[f] == null || (d[f] is string && d[f] in allowed); }
    function intIn(d, f, lo, hi) { return f in d && d[f] is int && d[f] >= lo && d[f] <= hi; }
    function optIntIn(d, f, lo, hi) { return !(f in d) || d[f] == null || (d[f] is int && d[f] >= lo && d[f] <= hi); }
    function optBool(d, f) { return !(f in d) || d[f] is bool; }
    function isDay(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function dayIn(d, f) { return f in d && isDay(d[f]); }
    function optList(d, f, max) { return !(f in d) || (d[f] is list && d[f].size() <= max); }
    function recordOk(d) {
      return (!('_edits' in d) || d._edits is map)
        && d.updatedAt is number
        && (!('createdAt' in d) || d.createdAt is number)
        && (resource == null || !('createdAt' in resource.data) || !('createdAt' in d) || d.createdAt == resource.data.createdAt);
    }

    // The doctors the roster places. A name is the key leave, requests and calls use. grade: con (consultant), reg (registrar or
    // fellow), mo (medical officer); team is free text ("Team 1"); active false takes someone off without losing the old rosters.
    match /spaces/{g}/people/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'grade', 'rank', 'site', 'team', 'active', 'noCall', 'moCalls', 'siteOnly', 'byHand', 'works', 'clinicsOnly', 'extra', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'name', 60)
        && oneOfStr(request.resource.data, 'grade', ['con', 'reg', 'mo'])
        && optStr(request.resource.data, 'rank', 20)
        && optOneOf(request.resource.data, 'site', ['NUH', 'NTFGH'])
        && optStr(request.resource.data, 'team', 30)
        && optBool(request.resource.data, 'active') && optBool(request.resource.data, 'noCall') && optBool(request.resource.data, 'moCalls') && optBool(request.resource.data, 'siteOnly') && optBool(request.resource.data, 'byHand') && optBool(request.resource.data, 'clinicsOnly')
        && (!('works' in request.resource.data) || request.resource.data.works == null || (request.resource.data.works is list && request.resource.data.works.size() <= 10 && request.resource.data.works.hasOnly(['1AM', '1PM', '2AM', '2PM', '3AM', '3PM', '4AM', '4PM', '5AM', '5PM'])))
        && optBool(request.resource.data, 'extra')
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // The weekly template of OT lists and clinics: one row per list per session of a weekday (wd 1 Monday to 5 Friday).
    match /spaces/{g}/lists/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['site', 'kind', 'name', 'wd', 'session', 'consultant', 'rooms', 'patients', 'need', 'min', 'status', 'external', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'site', 20)
        && oneOfStr(request.resource.data, 'kind', ['ot', 'msp', 'clinic', 'hot'])
        && str(request.resource.data, 'name', 40)
        && intIn(request.resource.data, 'wd', 1, 5)
        && oneOfStr(request.resource.data, 'session', ['AM', 'PM'])
        && optStr(request.resource.data, 'consultant', 60) && optStr(request.resource.data, 'rooms', 40)
        && optIntIn(request.resource.data, 'patients', 0, 200)
        && intIn(request.resource.data, 'need', 0, 10) && optIntIn(request.resource.data, 'min', 0, 10)
        && oneOfStr(request.resource.data, 'status', ['open', 'closed', 'template', 'empty', 'consultant-only'])
        && optBool(request.resource.data, 'external')
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // Leave: a person away from a day to a day (inclusive), all day or one session.
    match /spaces/{g}/leave/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'from', 'to', 'session', 'note', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'name', 60)
        && dayIn(request.resource.data, 'from') && dayIn(request.resource.data, 'to') && request.resource.data.from <= request.resource.data.to
        && optOneOf(request.resource.data, 'session', ['AM', 'PM', 'both'])
        && optStr(request.resource.data, 'note', 200)
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // Call requests: a day a person cannot do or would like, for one tier or any.
    match /spaces/{g}/requests/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['name', 'date', 'type', 'tier', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && str(request.resource.data, 'name', 60)
        && dayIn(request.resource.data, 'date')
        && oneOfStr(request.resource.data, 'type', ['cannot', 'want'])
        && optOneOf(request.resource.data, 'tier', ['con', 'reg', 'reg2', 'moNuh', 'moNtf'])
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // A month's on-call roster, named YYYY-MM: calls (a row per day), locked (entries set by hand), holidays, problems, and
    // tierPlan (which call tiers each kind of day has).
    match /spaces/{g}/rosters/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped() && id.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['calls', 'locked', 'holidays', 'problems', 'tierPlan', 'minGap', 'seed', 'built', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && optList(request.resource.data, 'calls', 62) && optList(request.resource.data, 'locked', 200)
        && optList(request.resource.data, 'holidays', 31) && optList(request.resource.data, 'problems', 60)
        && optIntIn(request.resource.data, 'minGap', 0, 7) && optIntIn(request.resource.data, 'seed', 0, 1000000)
        && (!('built' in request.resource.data) || request.resource.data.built is number)
        && (!('tierPlan' in request.resource.data) || (request.resource.data.tierPlan is map && request.resource.data.tierPlan.keys().hasOnly(['weekday', 'sat', 'sun', 'ph'])))
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // A week's daily roster, named by its Monday (YYYY-MM-DD): the grid, a snapshot of the lists as built, and this week's changes.
    match /spaces/{g}/weeks/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped() && isDay(id)
        && request.resource.data.keys().hasOnly(['grid', 'lists', 'overrides', 'built', 'seed', 'createdAt', 'updatedAt', 'serverAt', '_edits'])
        && optList(request.resource.data, 'grid', 800) && optList(request.resource.data, 'lists', 400) && optList(request.resource.data, 'overrides', 200)
        && optIntIn(request.resource.data, 'seed', 0, 1000000)
        && (!('built' in request.resource.data) || request.resource.data.built is number)
        && recordOk(request.resource.data);
      allow delete: if can(g, ['admin', 'member']);
    }

    // modules: rules{ written from app/rules/*.rules by node tools/modules.mjs; edit those, not this block
    // }modules

    // Each person's account options (@core/settings): one doc named by their uid, writable by them alone. The group can read the
    // docs because a list listen cannot be proven to ask for only one (rules are not filters); keep secrets out of options.
    // One field per account option (src/options.js: none yet, every option is this device's); null forgets a saved value.
    match /spaces/{g}/settings/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member', 'viewer']) && request.auth.uid == id && stamped()
        && request.resource.data.keys().hasOnly(['profile', 'updatedAt', 'serverAt', '_edits'])
        && (!('_edits' in request.resource.data) || request.resource.data._edits is map)
        && (!('profile' in request.resource.data) || request.resource.data.profile == null || request.resource.data.profile is string)
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // A deleted item's last version, written in the delete's own transaction (cloud.js onCommit).
    match /spaces/{g}/bin/{id} {
      allow read: if can(g, ['admin', 'member', 'viewer']);
      allow create, update: if can(g, ['admin', 'member']) && stamped()
        && request.resource.data.keys().hasOnly(['id', 'kind', 'data', 'deletedAt', 'updatedAt', 'serverAt']);
    }
  }
}
